# Copy to .env (scripts/setup.sh does this and generates the token). Never commit .env.
ENVIRONMENT=development

# PostgreSQL. docker-compose publishes it on 5544 to avoid clashing with other local databases.
DATABASE_URL=postgresql+psycopg://csmasf:csmasf_dev_password@127.0.0.1:5544/csmasf
POSTGRES_PASSWORD=csmasf_dev_password

# Shared secret between the backend and the execution service. Use a long random value.
RUNNER_TOKEN=change-me-to-a-long-random-value
RUNNER_URL=http://127.0.0.1:8102
# docker = isolated containers (recommended). local_dev_unsafe = NOT isolated, your own machine only.
RUNNER_BACKEND=docker

# Tutor text generation. none = deterministic built-in hints; no key required.
# Options: none | openai | anthropic | ollama. See docs/models.md
LLM_PROVIDER=none
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=qwen2.5-coder:1.5b

# Teacher registration needs this code. Leave empty to disable teacher sign-up.
TEACHER_INVITE_CODE=

# Enables the "Try the demo" buttons and synthetic demo records. Set false for real studies.
DEMO_MODE=true
RETRIEVAL_ALLOW_SYNTHETIC=true

# Add Question, import from a link. Opening pages can be turned off, and paste still works. See docs/data-imports.md
IMPORT_PAGE_FETCH=true
# Comma-separated domains this server will never open, for example example.com,example.org
IMPORT_BLOCKED_DOMAINS=

# Only used when the frontend is served from a different origin than the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
